<html>
  <head>
    <title>Mini Message Board</title>
    <link rel="stylesheet" href="./styles.css">
  </head>
  <body>
    <h1><%= locals.title %></h1>
    <ul class="message-container">
      <% messages.forEach((message) => { %>
      <div class="message">
        <p><%=message.user %></p>
        <p><%= message.text %></p>
        <p><%= message.added %></p>
      </div>
    <% }) %>
    </ul>
  </body>
</html>